# Copy to .env.notifications beside this file. Never commit the filled file.
# Leave values empty for simulation. Restart the API after changing this file.
JAGAAI_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_VOICE_FROM=
TWILIO_SMS_FROM=

# For public hosting, explicitly allow the same HTTPS origin for guard acceptance.
# Include local development origins too if you still use the local Vite frontend.
# Example (replace the domain; no trailing slash):
# JAGAAI_ALLOWED_ORIGINS=https://security.example.com,http://127.0.0.1:5174,http://127.0.0.1:8766
# JAGAAI_SECURE_COOKIE=1
# JAGAAI_FRONTEND_DIR=C:/path/to/jagaai/v3/frontend/dist
